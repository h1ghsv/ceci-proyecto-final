    "    Path(\"data/consolidado/ceci_formosa.csv\"),\n",
    "    Path(\"../data/consolidado/ceci_formosa.csv\"),\n",
    "    Path(\"ceci_formosa_export_sintetico_GITHUB.csv\"),\n",
    "    Path(\"../ceci_formosa_export_sintetico_GITHUB.csv\"),\n",
    "    Path(\"/mnt/data/ceci_formosa_export_sintetico_GITHUB.csv\"),\n",
    "]\n",
    "\n",
    "DATA = next((p for p in candidatos if p.exists()), None)\n",
    "\n",
    "if DATA is None:\n",
